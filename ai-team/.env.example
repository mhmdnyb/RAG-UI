# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=university_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
# Read by the application (pydantic-settings). Must be a full URL.
DATABASE_URL=postgresql://admin:changeme@localhost:5432/university_db

# ── Web service ───────────────────────────────────────────────
RAG_SERVICE_PORT=8000
# Token Core Service must send us. Empty = auth disabled (dev only).
RAG_SERVICE_TOKEN=

# ── Core Service callback ─────────────────────────────────────
CORE_SERVICE_URL=http://localhost:8080
RAG_CALLBACK_TOKEN=
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_ATTEMPTS=5

# ── Job queue (TaskIQ) ────────────────────────────────────────
# false = run jobs inside the API process (no Redis), development only
USE_QUEUE=false
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=rag_jobs
PIPELINE_TIMEOUT_SECONDS=120
# In-flight jobs per worker. `make worker` reads the same variable.
MAX_CONCURRENT_JOBS=30

# ── Default LLM (Global fallback for all LLM calls) ───────────
# If set, both answer generation and query routing use these settings.
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=
DEFAULT_LLM_MODEL=gpt-4o-mini
# Standard alias:
OPENAI_API_KEY=

# ── Answer Generation LLM (Overrides default if set) ─────────
# Leave empty to inherit from DEFAULT_LLM_*
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── Query Router LLM (Overrides default if set) ───────────────
# Leave empty to inherit from DEFAULT_LLM_* (e.g., set to OpenRouter if desired)
ROUTER_API_KEY=
ROUTER_BASE_URL=
ROUTER_MODEL=
ROUTER_TEMPERATURE=0.0

# ── Embedding (local LlamaIndex model) ────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4

# ── Reranker (Cross-Encoder) ──────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_SCORE_THRESHOLD=0.20
RERANKER_BATCH_SIZE=16
