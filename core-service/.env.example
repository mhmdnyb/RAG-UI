DB_NAME=your database name
DB_USERNAME=your username
DB_PASSWORD=your password
DB_HOST=your database host
DB_PORT=your database port
RAG_SERVICE_HOST=rag service host
RAG_SERVICE_PORT=rag service port
RAG_SERVICE_TOKEN=token to request to rag service
RAG_CALLBACK_TOKEN=token to check rag service requests
JWT_SECRET=your secret